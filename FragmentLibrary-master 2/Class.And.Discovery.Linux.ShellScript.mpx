<ManagementPackFragment SchemaVersion="2.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!--
%%
Description:
  A CLASS and DISCOVERY for Linux/Unix objects discovered by running a shell command on the
  Linux/Unix agent (via the Microsoft Unix/Linux (SCX) agent WSMan Invoke Probe Action) and
  parsing its StdOut with a PowerShell script that runs on the management server. Supports
  discovering MULTIPLE instances per host in a single run (the PowerShell script may call
  $DiscoveryData.AddInstance() once per parsed line/object, e.g. one instance per NFS mount).

  Generated by SCOM MP Creator (aka.ms/mpbuilder) - Linux Shell Script Discovery / NFS Mount
  Discovery capability. Module pattern (Scheduler + MUL WSMan Invoke ProbeAction + Windows
  PowerShellDiscoveryProbe, composed via two nested DataSourceModuleType composites) is modeled
  after the verified, publicly-published Unix/Linux discovery fragments in Kevin Holman's
  FragmentLibrary (https://github.com/thekevinholman/FragmentLibrary), specifically
  Class.And.Discovery.Unix.ShellCommand.Properties.mpx.

  Placeholders substituted by SCOM MP Creator:
    ##CompanyID##          - short company abbreviation, no spaces/special characters
    ##AppName##            - short app name, no spaces/special characters
    ##UniqueID##           - unique short id for this discovery/class, no spaces/special characters
    ##ShellCommand##       - shell command executed on the Linux/Unix agent (its StdOut is parsed below)
    ##ParsingScript##      - PowerShell parser body; its output is buffered until parsing completes successfully
    ##ProbeActionTypeID##  - MUL!Microsoft.Unix.WSMan.Invoke.ProbeAction or the .Privileged. variant
    ##KeyPropertyName##    - discovered class key property name
    ##Property2Name## / ##Property3Name## / ##Property4Name## - additional discovered class property names
    ##IntervalSeconds##    - discovery schedule interval, in seconds
    ##TimeoutSeconds##     - shell command timeout, in seconds

Version: 1.0
LastModified: 2026
%%

This fragment depends on references:
  RequiredReference: Alias="System", ID="System.Library"
  RequiredReference: Alias="Windows", ID="Microsoft.Windows.Library"
  RequiredReference: Alias="MUL", ID="Microsoft.Unix.Library"
  RequiredReference: Alias="MSWL", ID="Microsoft.SystemCenter.WSManagement.Library"

@@Author=SCOM MP Creator (aka.ms/mpbuilder)@@
-->
  <TypeDefinitions>
    <EntityTypes>
      <ClassTypes>
        <ClassType ID="##CompanyID##.##AppName##.##UniqueID##.Class" Accessibility="Public" Abstract="false" Base="MUL!Microsoft.Unix.LocalApplication" Hosted="true" Singleton="false">
          <Property ID="##KeyPropertyName##" Type="string" Key="true" CaseSensitive="true" MaxLength="256" MinLength="0" />
          <Property ID="##Property2Name##" Type="string" Key="false" CaseSensitive="false" MaxLength="1024" MinLength="0" />
          <Property ID="##Property3Name##" Type="string" Key="false" CaseSensitive="false" MaxLength="256" MinLength="0" />
          <Property ID="##Property4Name##" Type="string" Key="false" CaseSensitive="false" MaxLength="1024" MinLength="0" />
        </ClassType>
      </ClassTypes>
    </EntityTypes>
    <ModuleTypes>
      <DataSourceModuleType ID="##CompanyID##.##AppName##.##UniqueID##.Class.ShellCommand.DS" Accessibility="Internal" Batching="false">
        <Configuration>
          <xsd:element minOccurs="1" name="IntervalSeconds" type="xsd:integer" />
          <xsd:element minOccurs="1" name="TargetSystem" type="xsd:string" />
          <xsd:element minOccurs="1" name="ShellCommand" type="xsd:string" />
          <xsd:element minOccurs="1" name="TimeOutSeconds" type="xsd:integer" />
        </Configuration>
        <OverrideableParameters>
          <OverrideableParameter ID="IntervalSeconds" Selector="$Config/IntervalSeconds$" ParameterType="int" />
          <OverrideableParameter ID="TimeOutSeconds" Selector="$Config/TimeOutSeconds$" ParameterType="int" />
        </OverrideableParameters>
        <ModuleImplementation Isolation="Any">
          <Composite>
            <MemberModules>
              <DataSource ID="Scheduler" TypeID="System!System.Scheduler">
                <Scheduler>
                  <SimpleReccuringSchedule>
                    <Interval>$Config/IntervalSeconds$</Interval>
                  </SimpleReccuringSchedule>
                  <ExcludeDates />
                </Scheduler>
              </DataSource>
              <ProbeAction ID="ProbeAction" TypeID="##ProbeActionTypeID##">
                <TargetSystem>$Config/TargetSystem$</TargetSystem>
                <Uri>http://schemas.microsoft.com/wbem/wscim/1/cim-schema/2/SCX_OperatingSystem?__cimnamespace=root/scx</Uri>
                <Selector />
                <InvokeAction>ExecuteShellCommand</InvokeAction>
                <Input>&lt;p:ExecuteShellCommand_INPUT xmlns:p="http://schemas.microsoft.com/wbem/wscim/1/cim-schema/2/SCX_OperatingSystem"&gt;&lt;p:command&gt;$Config/ShellCommand$&lt;/p:command&gt;&lt;p:timeout&gt;$Config/TimeOutSeconds$&lt;/p:timeout&gt;&lt;/p:ExecuteShellCommand_INPUT&gt;</Input>
              </ProbeAction>
            </MemberModules>
            <Composition>
              <Node ID="ProbeAction">
                <Node ID="Scheduler" />
              </Node>
            </Composition>
          </Composite>
        </ModuleImplementation>
        <OutputType>MSWL!Microsoft.SystemCenter.WSManagement.WSManData</OutputType>
      </DataSourceModuleType>
      <DataSourceModuleType ID="##CompanyID##.##AppName##.##UniqueID##.Class.Discovery.DS" Accessibility="Public" Batching="false">
        <Configuration>
          <xsd:element minOccurs="1" name="IntervalSeconds" type="xsd:integer" />
          <xsd:element minOccurs="1" name="TargetSystem" type="xsd:string" />
          <xsd:element minOccurs="1" name="ShellCommand" type="xsd:string" />
          <xsd:element minOccurs="1" name="TimeOutSeconds" type="xsd:integer" />
        </Configuration>
        <OverrideableParameters>
          <OverrideableParameter ID="IntervalSeconds" Selector="$Config/IntervalSeconds$" ParameterType="int" />
          <OverrideableParameter ID="TimeOutSeconds" Selector="$Config/TimeOutSeconds$" ParameterType="int" />
        </OverrideableParameters>
        <ModuleImplementation Isolation="Any">
          <Composite>
            <MemberModules>
              <DataSource ID="DS" TypeID="##CompanyID##.##AppName##.##UniqueID##.Class.ShellCommand.DS">
                <IntervalSeconds>$Config/IntervalSeconds$</IntervalSeconds>
                <TargetSystem>$Config/TargetSystem$</TargetSystem>
                <ShellCommand>$Config/ShellCommand$</ShellCommand>
                <TimeOutSeconds>$Config/TimeOutSeconds$</TimeOutSeconds>
              </DataSource>
              <ProbeAction ID="PSDisco" TypeID="Windows!Microsoft.Windows.PowerShellDiscoveryProbe">
                <ScriptName>##CompanyID##.##AppName##.##UniqueID##.Class.Discovery.ps1</ScriptName>
                <ScriptBody>param($SourceId,$ManagedEntityId,[string]$TargetSystem,[string]$StdOut,[string]$ReturnCode,[string]$StdErr)

$FailureScriptName = "##CompanyID##.##AppName##.##UniqueID##.Class.Discovery.ps1"
$FailureEventID = 9002
$FailureMomApi = New-Object -ComObject MOM.ScriptAPI

function Get-LimitedDiscoveryErrorText {
    param([string]$Text)
    if ([string]::IsNullOrEmpty($Text)) { return "&lt;empty&gt;" }
    if ($Text.Length -le 2048) { return $Text }
    return $Text.Substring(0, 2048) + "... [truncated]"
}

[int]$ParsedReturnCode = 0
if (-not [int]::TryParse($ReturnCode, [ref]$ParsedReturnCode)) {
    $FailureMomApi.LogScriptEvent($FailureScriptName,$FailureEventID,1,"Linux discovery received an invalid shell ReturnCode '$ReturnCode' for ($TargetSystem). No discovery snapshot was published.")
    throw "Invalid shell ReturnCode '$ReturnCode'."
}

if ($ParsedReturnCode -ne 0) {
    $StdErrContext = Get-LimitedDiscoveryErrorText $StdErr
    $StdOutContext = Get-LimitedDiscoveryErrorText $StdOut
    $FailureMomApi.LogScriptEvent($FailureScriptName,$FailureEventID,1,"Linux discovery shell command failed on ($TargetSystem). ReturnCode: $ParsedReturnCode. StdErr: $StdErrContext. StdOut: $StdOutContext. No discovery snapshot was published.")
    throw "Linux discovery shell command failed with ReturnCode $ParsedReturnCode."
}

$DiscoveryParser = {
##ParsingScript##
}

try {
    # Buffer parser output. A parser exception therefore cannot publish an incomplete
    # DiscoveryData snapshot that would remove previously discovered instances.
    $ParserOutput = &amp; $DiscoveryParser $SourceId $ManagedEntityId $TargetSystem $StdOut $ReturnCode $StdErr
}
catch {
    $FailureMomApi.LogScriptEvent($FailureScriptName,$FailureEventID,1,"Linux discovery parsing failed on ($TargetSystem): $($_.Exception.Message). No discovery snapshot was published.")
    throw
}

$ParserOutput</ScriptBody>
                <Parameters>
                  <Parameter>
                    <Name>SourceId</Name>
                    <Value>$MPElement$</Value>
                  </Parameter>
                  <Parameter>
                    <Name>ManagedEntityId</Name>
                    <Value>$Target/Id$</Value>
                  </Parameter>
                  <Parameter>
                    <Name>TargetSystem</Name>
                    <Value>$Config/TargetSystem$</Value>
                  </Parameter>
                  <Parameter>
                    <Name>StdOut</Name>
                    <Value>$Data///*[local-name()="StdOut"]$</Value>
                  </Parameter>
                  <Parameter>
                    <Name>ReturnCode</Name>
                    <Value>$Data///*[local-name()="ReturnCode"]$</Value>
                  </Parameter>
                  <Parameter>
                    <Name>StdErr</Name>
                    <Value>$Data///*[local-name()="StdErr"]$</Value>
                  </Parameter>
                </Parameters>
                <TimeoutSeconds>300</TimeoutSeconds>
              </ProbeAction>
            </MemberModules>
            <Composition>
              <Node ID="PSDisco">
                <Node ID="DS" />
              </Node>
            </Composition>
          </Composite>
        </ModuleImplementation>
        <OutputType>System!System.Discovery.Data</OutputType>
      </DataSourceModuleType>
    </ModuleTypes>
  </TypeDefinitions>
  <Monitoring>
    <Discoveries>
      <Discovery ID="##CompanyID##.##AppName##.##UniqueID##.Class.Discovery" Enabled="true" Target="MUL!Microsoft.Unix.Computer" ConfirmDelivery="true" Remotable="true" Priority="Normal">
        <Category>Discovery</Category>
        <DiscoveryTypes>
          <DiscoveryClass TypeID="##CompanyID##.##AppName##.##UniqueID##.Class">
            <Property TypeID="##CompanyID##.##AppName##.##UniqueID##.Class" PropertyID="##KeyPropertyName##" />
            <Property TypeID="##CompanyID##.##AppName##.##UniqueID##.Class" PropertyID="##Property2Name##" />
            <Property TypeID="##CompanyID##.##AppName##.##UniqueID##.Class" PropertyID="##Property3Name##" />
            <Property TypeID="##CompanyID##.##AppName##.##UniqueID##.Class" PropertyID="##Property4Name##" />
          </DiscoveryClass>
        </DiscoveryTypes>
        <DataSource ID="DS" TypeID="##CompanyID##.##AppName##.##UniqueID##.Class.Discovery.DS">
          <IntervalSeconds>##IntervalSeconds##</IntervalSeconds>
          <TargetSystem>$Target/Property[Type="MUL!Microsoft.Unix.Computer"]/PrincipalName$</TargetSystem>
          <ShellCommand>##ShellCommand##</ShellCommand>
          <TimeOutSeconds>##TimeoutSeconds##</TimeOutSeconds>
        </DataSource>
      </Discovery>
    </Discoveries>
  </Monitoring>
  <LanguagePacks>
    <LanguagePack ID="ENU" IsDefault="true">
      <DisplayStrings>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Class">
          <Name>##CompanyID## ##AppName## ##UniqueID## Class</Name>
          <Description>Discovered via a Linux/Unix shell script (##UniqueID## Shell Script Discovery)</Description>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Class" SubElementID="##KeyPropertyName##">
          <Name>##KeyPropertyName##</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Class" SubElementID="##Property2Name##">
          <Name>##Property2Name##</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Class" SubElementID="##Property3Name##">
          <Name>##Property3Name##</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Class" SubElementID="##Property4Name##">
          <Name>##Property4Name##</Name>
        </DisplayString>
        <DisplayString ElementID="##CompanyID##.##AppName##.##UniqueID##.Class.Discovery">
          <Name>##CompanyID## ##AppName## ##UniqueID## Class Discovery</Name>
          <Description>Runs a shell command on the Linux/Unix agent and parses its output to discover one or more ##UniqueID## objects.</Description>
        </DisplayString>
      </DisplayStrings>
    </LanguagePack>
  </LanguagePacks>
</ManagementPackFragment>
